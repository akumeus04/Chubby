<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chubby Chat - WebRTC Demo 2.0</title>
  <style>
    body { font-family: sans-serif; background: #0e0f14; color: white; text-align: center; margin: 0; padding: 15px; }
    input, button { padding: 12px; margin: 5px; border-radius: 6px; border: none; font-size: 14px; }
    button { background: #007bff; color: white; cursor: pointer; font-weight: bold; }
    button:hover { background: #0056b3; }
    button:disabled { background: #555; cursor: not-allowed; }
    
    /* 🌸 NEW: Diagnostic Status Box */
    #statusBox { background: #222; border-left: 4px solid #f39c12; padding: 12px; margin: 15px auto; max-width: 500px; text-align: left; font-family: monospace; font-size: 13px; border-radius: 4px; color: #ddd; }
    #statusBox span { display: block; margin-top: 4px; color: #f39c12; font-weight: bold;}
    
    /* 🌸 NEW: Picture-in-Picture Video Layout */
    .video-wrapper { position: relative; max-width: 500px; margin: 20px auto; background: #111; border-radius: 12px; overflow: hidden; border: 1px solid #333; aspect-ratio: 3/4; display: flex; align-items: center; justify-content: center; }
    .video-wrapper::before { content: "Partner Video Loading..."; position: absolute; color: #555; z-index: 0; }
    
    #remoteVideo { width: 100%; height: 100%; object-fit: cover; z-index: 1; position: relative; }
    #localVideo { position: absolute; bottom: 15px; right: 15px; width: 120px; aspect-ratio: 3/4; object-fit: cover; border-radius: 8px; border: 2px solid white; z-index: 10; box-shadow: 0 4px 10px rgba(0,0,0,0.5); background: #000; }
    
    #app-section { display: none; }
  </style>
</head>
<body>

  <h2>Chubby Video Setup</h2>

  <!-- 1. LOGIN SECTION -->
  <div id="login-section">
    <input type="email" id="email" placeholder="Email">
    <input type="password" id="password" placeholder="Password">
    <button id="loginBtn">Login</button>
  </div>

  <!-- 2. CALL INTERFACE -->
  <div id="app-section">
    
    <div id="statusBox">
      System: Ready to connect...
      <span id="liveStatus">Status: Idle</span>
    </div>

    <div>
      <input type="text" id="customRoomInput" placeholder="Room name (e.g. room1)">
      <button id="startCallBtn">Start Call</button>
      <button id="answerCallBtn">Answer Call</button>
    </div>

    <div class="video-wrapper">
      <!-- The main big screen for the partner (DO NOT MUTE THIS ONE) -->
      <video id="remoteVideo" autoplay playsinline></video>
      <!-- The small picture-in-picture for yourself (MUST BE MUTED) -->
      <video id="localVideo" autoplay playsinline muted></video>
    </div>

  </div>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
    import { getAuth, signInWithEmailAndPassword } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
    import { getFirestore, collection, doc, setDoc, getDoc, onSnapshot, addDoc } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

    // ─── 1. YOUR FIREBASE CONFIG ───────────────────────────────────────────
    const firebaseConfig = {
  apiKey: "AIzaSyA3iIqEl718iLfHKfn9S0d_60PAN4BtcS0",
  authDomain: "ourmessenger-76636.firebaseapp.com",
  databaseURL: "https://ourmessenger-76636-default-rtdb.firebaseio.com",
  projectId: "ourmessenger-76636",
  storageBucket: "ourmessenger-76636.firebasestorage.app",
  messagingSenderId: "541588910843",
  appId: "1:541588910843:web:221fd00e69a4711624b65e"
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getFirestore(app);

    // ─── 2. WEBRTC ENGINE ──────────────────────────────────────────────────
    const servers = {
      iceServers: [
        { urls: ['stun:stun1.l.google.com:19302', 'stun:stun2.l.google.com:19302'] }
      ],
      iceCandidatePoolSize: 10
    };

    const pc = new RTCPeerConnection(servers);
    
    const localVideo = document.getElementById('localVideo');
    const remoteVideo = document.getElementById('remoteVideo');
    const liveStatus = document.getElementById('liveStatus');

    // Live Logger Helper
    function updateStatus(msg, color = "#f39c12") {
      liveStatus.innerText = "Status: " + msg;
      liveStatus.style.color = color;
      console.log("[WebRTC]:", msg);
    }

    // Monitor Network Connection
    pc.onconnectionstatechange = () => {
      if (pc.connectionState === 'connecting') updateStatus("Connecting through network...", "#3498db");
      if (pc.connectionState === 'connected') updateStatus("✅ Connected! Live Video & Audio active.", "#2ecc71");
      if (pc.connectionState === 'disconnected') updateStatus("⚠️ Partner disconnected.", "#e74c3c");
      if (pc.connectionState === 'failed') updateStatus("❌ Connection Failed! (Firewall blocked the stream)", "#e74c3c");
    };

    // ─── 3. AUTHENTICATION ─────────────────────────────────────────────────
    document.getElementById('loginBtn').onclick = async () => {
      try {
        updateStatus("Logging in...", "#aaa");
        await signInWithEmailAndPassword(auth, document.getElementById('email').value, document.getElementById('password').value);
        document.getElementById('login-section').style.display = 'none';
        document.getElementById('app-section').style.display = 'block';
        updateStatus("Logged in. Requesting camera access...", "#aaa");
        await setupHardware();
      } catch (e) {
        updateStatus("Login Failed: " + e.message, "red");
      }
    };

    // ─── 4. HARDWARE SETUP ─────────────────────────────────────────────────
    async function setupHardware() {
      try {
        // Request camera and microphone explicitly
        const stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
        
        // Show your own face in the small box
        localVideo.srcObject = stream;
        
        // Feed your camera/mic into the network connection
        stream.getTracks().forEach(track => pc.addTrack(track, stream));

        // When the partner's data arrives, push it directly to the big screen
        pc.ontrack = (event) => {
          updateStatus("Receiving partner's video and audio...", "#3498db");
          remoteVideo.srcObject = event.streams[0];
        };
        
        updateStatus("Hardware ready. Enter room name and Start/Answer.");
      } catch (err) {
        updateStatus("Hardware Error: Could not access Camera/Mic.", "red");
        alert("Please ensure browser permissions for Camera and Microphone are allowed!");
      }
    }

    // ─── 5. CALLER LOGIC (Start Call) ──────────────────────────────────────
    document.getElementById('startCallBtn').onclick = async () => {
      const roomId = document.getElementById('customRoomInput').value.trim();
      if (!roomId) return alert("Type a room name first!");
      
      updateStatus("Creating room: " + roomId + "...");
      const callDoc = doc(db, 'calls', roomId);
      const offerCandidates = collection(callDoc, 'offerCandidates');
      const answerCandidates = collection(callDoc, 'answerCandidates');

      pc.onicecandidate = e => { if (e.candidate) addDoc(offerCandidates, e.candidate.toJSON()); };

      const offerDesc = await pc.createOffer();
      await pc.setLocalDescription(offerDesc);
      await setDoc(callDoc, { offer: { sdp: offerDesc.sdp, type: offerDesc.type } });

      updateStatus("⏳ Room created! Waiting for partner to answer...", "#f39c12");

      onSnapshot(callDoc, (snapshot) => {
        const data = snapshot.data();
        if (!pc.currentRemoteDescription && data?.answer) {
          updateStatus("Partner found! Finalizing connection...");
          pc.setRemoteDescription(new RTCSessionDescription(data.answer));
        }
      });

      onSnapshot(answerCandidates, (snapshot) => {
        snapshot.docChanges().forEach((change) => {
          if (change.type === 'added') pc.addIceCandidate(new RTCIceCandidate(change.doc.data()));
        });
      });
    };

    // ─── 6. CALLEE LOGIC (Answer Call) ─────────────────────────────────────
    document.getElementById('answerCallBtn').onclick = async () => {
      const roomId = document.getElementById('customRoomInput').value.trim();
      if (!roomId) return alert("Type the room name first!");

      updateStatus("Joining room: " + roomId + "...");
      const callDoc = doc(db, 'calls', roomId);
      const offerCandidates = collection(callDoc, 'offerCandidates');
      const answerCandidates = collection(callDoc, 'answerCandidates');

      pc.onicecandidate = e => { if (e.candidate) addDoc(answerCandidates, e.candidate.toJSON()); };

      const callData = (await getDoc(callDoc)).data();
      if (!callData) return updateStatus("❌ Room not found! Did they start the call?", "red");

      await pc.setRemoteDescription(new RTCSessionDescription(callData.offer));
      const answerDesc = await pc.createAnswer();
      await pc.setLocalDescription(answerDesc);
      await setDoc(callDoc, { answer: { sdp: answerDesc.sdp, type: answerDesc.type } }, { merge: true });

      onSnapshot(offerCandidates, (snapshot) => {
        snapshot.docChanges().forEach((change) => {
          if (change.type === 'added') pc.addIceCandidate(new RTCIceCandidate(change.doc.data()));
        });
      });
    };
  </script>
</body>
</html>
